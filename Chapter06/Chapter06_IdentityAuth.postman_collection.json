  "item": [
    {
      "name": "User Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var stamp = Date.now().toString();",
                  "pm.collectionVariables.set('newUserName', 'postman_user_' + stamp);",
                  "pm.collectionVariables.set('newUserEmail', 'postman_user_' + stamp + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register user success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('userAccessToken', json.data.access.token);",
                  "  pm.collectionVariables.set('userRefreshToken', json.data.refresh.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{newUserName}}\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "auth",
                "register"
              ]
            },
            "description": "Dang ky user moi voi email duoc tao dong de tranh trung lap. Sau khi thanh cong se luu access/refresh token."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login user success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('userAccessToken', json.data.access.token);",
                  "  pm.collectionVariables.set('userRefreshToken', json.data.refresh.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/auth/login",
