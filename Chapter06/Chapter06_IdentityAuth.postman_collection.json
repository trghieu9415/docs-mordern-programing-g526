    {
      "name": "Verification",
      "item": [
        {
          "name": "Lockout Setup - Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var stamp = Date.now().toString();",
                  "pm.collectionVariables.set('lockoutEmail', 'lockout_user_' + stamp + '@example.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"lockout_user\",\n  \"email\": \"{{lockoutEmail}}\",\n  \"password\": \"{{lockoutPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "auth",
                "register"
              ]
            },
            "description": "Moi lan chay se tao email lockout moi de ban test 5 lan sai mat khau ma khong dung du lieu cu."
          }
        },
        {
          "name": "Lockout Test - Wrong Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lockout endpoint returns 400 or 423', function () {",
                  "  pm.expect([400, 423]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lockoutEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "auth",
                "login"
              ]
            },
            "description": "Chay request nay 5 lan lien tiep. Lan thu 5 se ra 423 Locked."
          }
        },
        {
          "name": "Refresh Should Fail After SecurityStamp Changed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh after SecurityStamp change should fail with 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
