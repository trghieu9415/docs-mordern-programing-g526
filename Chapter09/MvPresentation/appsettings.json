{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TicketingDb": "Data Source=event-ticketing.db"
  },
  "Email": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Username": "YOUR_MAILTRAP_USERNAME",
    "Password": "YOUR_MAILTRAP_PASSWORD",
    "FromAddress": "no-reply@event-ticketing.local",
    "FromName": "Event Ticketing Demo",
    "EnableSsl": true
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET",
    "Currency": "vnd",
    "SuccessUrl": "https://localhost:7225/api/ticket-orders/return",
    "CancelUrl": "https://localhost:7225/api/ticket-orders/cancel"
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ClientId": "YOUR_PAYPAL_CLIENT_ID",
    "Secret": "YOUR_PAYPAL_SECRET",
    "ReturnUrl": "https://localhost:7225/api/ticket-orders/return",
    "CancelUrl": "https://localhost:7225/api/ticket-orders/cancel",
    "Currency": "USD",
    "BrandName": "Event Ticketing Demo",
    "WebhookId": "YOUR_PAYPAL_WEBHOOK_ID"
  },
  "AllowedHosts": "*"
}
